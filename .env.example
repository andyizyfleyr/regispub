# ───────────── Application ─────────────
APP_URL="http://localhost:3000"   # facultatif sur Vercel : le domaine de production est utilisé par défaut
# Chaîne aléatoire longue (openssl rand -hex 32). Sert à signer les références internes.
APP_SECRET="change-me-with-openssl-rand-hex-32"
# Secret exigé par /api/cron/* (en-tête Authorization: Bearer …). Vercel Cron l'envoie automatiquement.
CRON_SECRET=""

# ───────────── Base de données (PostgreSQL / Neon) ─────────────
# Neon : URL « pooled » pour l'application, URL directe pour les migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/regispub"
DIRECT_URL=""

# ───────────── Paiements Mobile Money ─────────────
# fedapay | sandbox  (sandbox = simulateur local, refusé en production sauf ALLOW_SANDBOX_PAYMENTS=true)
PAYMENT_PROVIDER="sandbox"
ALLOW_SANDBOX_PAYMENTS="false"
FEDAPAY_ENV="sandbox"            # sandbox | live
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# ───────────── Intelligence artificielle (multi-fournisseur) ─────────────
# Texte : openai | anthropic | gemini  (vide = suggestions guidées sans IA)
AI_TEXT_PROVIDER=""
AI_TEXT_MODEL=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""               # ex. https://openrouter.ai/api/v1 ou https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ───────────── Stockage des fichiers ─────────────
# local (développement) | s3 (S3, Cloudflare R2, MinIO, Backblaze…)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ───────────── Notifications ─────────────
EMAIL_PROVIDER=""                # resend (vide = e-mails non envoyés, journalisés)
EMAIL_FROM="RegisPub <no-reply@example.com>"
RESEND_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""      # WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME=""        # modèle approuvé par Meta (1 variable de corps)
WHATSAPP_TEMPLATE_LANG="fr"

# ───────────── API publicitaires (lecture des statistiques) ─────────────
META_ACCESS_TOKEN=""             # jeton système Business avec ads_read
META_API_VERSION="v23.0"
TIKTOK_ACCESS_TOKEN=""
TIKTOK_ADVERTISER_ID=""

# ───────────── Divers ─────────────
SESSION_COOKIE_SAMESITE="lax"    # lax | none (none uniquement pour une prévisualisation en iframe)
ALLOW_EMBEDDING="false"
SERVER_ACTIONS_ALLOWED_ORIGINS=""
SEED_ADMIN_EMAIL="admin@regispub.local"
SEED_ADMIN_PASSWORD=""
SEED_DEMO="false"                # true = comptes et campagne de démonstration (jamais en production)
LOCAL_DB_PORT="5433"             # port du PostgreSQL embarqué (npm run db:local)
DB_POOL_MAX="5"
LOG_LEVEL="info"                 # debug | info | warn | error
DEV_ALLOWED_ORIGINS=""           # origines supplémentaires acceptées par le serveur de développement

# ───────────── Conversion des dépenses publicitaires ─────────────
# Les comptes publicitaires facturés dans une autre devise sont convertis en FCFA avec ces taux (à tenir à jour).
FX_RATES_TO_XOF='{"USD":600,"EUR":655.957}'
TIKTOK_ACCOUNT_CURRENCY="USD"
