// RegisPub — modèle de données.
// Tous les montants sont des entiers en francs CFA (XOF n'a pas de sous-unité).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Comptes & accès ───────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  AD_MANAGER
  DESIGNER
  SUPPORT
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  phone          String?
  name           String
  passwordHash   String
  role           Role       @default(CLIENT)
  status         UserStatus @default(ACTIVE)
  accountType    String     @default("INDIVIDUAL") // INDIVIDUAL | PROFESSIONAL
  referralCode   String     @unique
  referredById   String?
  referredBy     User?      @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[]     @relation("Referrals")
  loyaltyPoints  Int        @default(0)
  notifyEmail    Boolean    @default(true)
  notifyWhatsapp Boolean    @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  businesses        Business[]
  campaigns         Campaign[]           @relation("CampaignOwner")
  managedCampaigns  Campaign[]           @relation("CampaignManager")
  designedCampaigns Campaign[]           @relation("CampaignDesigner")
  assets            Asset[]
  orders            Order[]
  payments          Payment[]
  messages          Message[]
  notifications     Notification[]
  tickets           Ticket[]             @relation("TicketAuthor")
  assignedTickets   Ticket[]             @relation("TicketAssignee")
  subscriptions     Subscription[]
  loyaltyEntries    LoyaltyEntry[]
  promoRedemptions  PromoRedemption[]
  ownedPromoCodes   PromoCode[]
  aiGenerations     AiGeneration[]
  calendarEntries   CalendarEntry[]
  revisionRequests  RevisionRequest[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Business {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  sector       String
  description  String?
  country      String   @default("BJ")
  city         String?
  whatsapp     String?
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  website      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns       Campaign[]
  assets          Asset[]
  subscriptions   Subscription[]
  calendarEntries CalendarEntry[]
  accesses        AccountAccess[]

  @@index([ownerId])
}

/// Accès donné par le client à l'un de ses comptes, pour que l'équipe y lance la publicité.
/// INVITE : le client a ajouté l'agence à sa page (ou fourni le code d'une vidéo TikTok).
/// LOGIN : le client a confié son identifiant et son mot de passe, chiffrés ; ils sont effacés à la fin de ses campagnes.
model AccountAccess {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform   Platform
  method     String
  /// SENT (à vérifier par l'équipe), VERIFIED, PROBLEM (à refaire par le client)
  status     String    @default("SENT")
  /// Identifiant de connexion ou code de vidéo TikTok, chiffré (AES-256-GCM)
  loginEnc   String?
  /// Mot de passe chiffré (AES-256-GCM)
  secretEnc  String?
  /// Campagne concernée quand l'accès ne vaut que pour elle (code de vidéo TikTok)
  campaignId String?
  /// Message de l'équipe quand l'accès ne fonctionne pas
  note       String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, platform])
}

// ─────────────────────────── Catalogue & tarification ───────────────────────────

enum ServiceKind {
  CAMPAIGN // prestation liée à un objectif publicitaire
  PACK // niveau d'accompagnement (création + publicité)
  MANAGEMENT // gestion complète par un expert
  SUBSCRIPTION // accompagnement mensuel
}

model Service {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  kind        ServiceKind
  fee         Int // FCFA — jamais inférieur au plancher (10 000 F)
  periodDays  Int? // abonnements uniquement
  features    String[]
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  type          PromoType
  value         Int
  maxUses       Int?
  usedCount     Int       @default(0)
  perUserLimit  Int       @default(1)
  minServiceFee Int?
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(true)
  source        String    @default("ADMIN") // ADMIN | LOYALTY | REFERRAL
  ownerId       String? // bon personnel : utilisable uniquement par ce client
  owner         User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  redemptions PromoRedemption[]
  orders      Order[]

  @@index([ownerId])
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  createdAt   DateTime  @default(now())

  @@index([promoCodeId, userId])
}

// ─────────────────────────── Campagnes ───────────────────────────

enum CampaignMode {
  SELF_SERVICE
  EXPERT
}

enum CampaignStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  AWAITING_INFO
  IN_PREPARATION
  CLIENT_REVIEW
  READY_TO_LAUNCH
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

model Campaign {
  id          String         @id @default(cuid())
  reference   String         @unique
  userId      String
  user        User           @relation("CampaignOwner", fields: [userId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  managerId   String?
  manager     User?          @relation("CampaignManager", fields: [managerId], references: [id], onDelete: SetNull)
  designerId  String?
  designer    User?          @relation("CampaignDesigner", fields: [designerId], references: [id], onDelete: SetNull)
  mode        CampaignMode   @default(SELF_SERVICE)
  status      CampaignStatus @default(DRAFT)
  name        String
  platforms   Platform[]
  objective   String?
  serviceCode String? // niveau d'accompagnement retenu

  productName         String?
  productDescription  String?
  productPrice        Int?
  audienceNote        String?
  destinationWhatsapp String?
  destinationUrl      String?
  brief               String?

  targeting    Json?
  strategy     Json?
  adCopy       Json?
  adBudget     Int       @default(0)
  budgetSplit  Json?
  durationDays Int?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  externalRefs Json? // identifiants des campagnes créées chez Meta / TikTok
  wizardStep   Int       @default(1)
  launchedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assets        CampaignAsset[]
  statusEvents  CampaignStatusEvent[]
  messages      Message[]
  revisions     RevisionRequest[]
  orders        Order[]
  metrics       MetricSnapshot[]
  metricImports MetricImport[]
  tickets       Ticket[]
  reads         CampaignRead[]

  @@index([userId, status])
  @@index([status])
  @@index([managerId])
}

enum AssetKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AssetSource {
  UPLOAD
  STUDIO
  AI
  STAFF
}

model Asset {
  id         String      @id @default(cuid())
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  kind       AssetKind
  source     AssetSource @default(UPLOAD)
  name       String
  mime       String
  size       Int
  width      Int?
  height     Int?
  format     String? // format publicitaire (square, story…)
  storageKey String      @unique
  design     Json? // état du studio créatif, pour réédition
  createdAt  DateTime    @default(now())

  campaignLinks CampaignAsset[]

  @@index([ownerId, createdAt])
}

enum CampaignAssetRole {
  PRODUCT_MEDIA
  CREATIVE
  BRIEF_FILE
  REPORT
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model CampaignAsset {
  id         String            @id @default(cuid())
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role       CampaignAssetRole
  approval   ApprovalStatus    @default(NOT_REQUIRED)
  feedback   String?
  addedById  String
  decidedAt  DateTime?
  createdAt  DateTime          @default(now())

  @@unique([campaignId, assetId, role])
  @@index([campaignId])
}

model CampaignStatusEvent {
  id         String          @id @default(cuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromStatus CampaignStatus?
  toStatus   CampaignStatus
  actorId    String?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([campaignId, createdAt])
}

model Message {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body       String
  internal   Boolean  @default(false) // note interne, invisible pour le client
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

model CampaignRead {
  userId     String
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([userId, campaignId])
}

enum RevisionStatus {
  OPEN
  IN_PROGRESS
  DONE
  REJECTED
}

model RevisionRequest {
  id          String         @id @default(cuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User           @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  description String
  status      RevisionStatus @default(OPEN)
  response    String?
  handledById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([campaignId])
  @@index([status])
}

// ─────────────────────────── Commandes & paiements ───────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  serviceCode    String
  serviceLabel   String
  adBudget       Int           @default(0) // montant reversé aux plateformes
  serviceFee     Int // prestation, avant remise
  discount       Int           @default(0)
  paymentFee     Int           @default(0)
  total          Int
  currency       String        @default("XOF")
  promoCodeId    String?
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  status         OrderStatus   @default(PENDING)
  invoiceNumber  String?       @unique
  quote          Json // détail figé du devis (lignes, règles appliquées)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments   Payment[]
  refunds    Refund[]
  redemption PromoRedemption?
  tickets    Ticket[]

  @@index([userId, createdAt])
  @@index([campaignId])
  @@index([status])
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum MobileOperator {
  MTN
  MOOV
  CELTIIS
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  operator       MobileOperator
  phone          String // MSISDN au format international, nécessaire aux remboursements
  amount         Int
  currency       String         @default("XOF")
  status         PaymentStatus  @default(INITIATED)
  providerRef    String?
  idempotencyKey String         @unique
  redirectUrl    String?
  providerStatus String?
  failureReason  String?
  duplicate      Boolean        @default(false) // encaissé alors que la commande était déjà réglée
  lastCheckedAt  DateTime?
  verifiedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, expiresAt])
}

// Journal des notifications reçues des prestataires (idempotence des webhooks).
model PaymentEvent {
  id             String   @id @default(cuid())
  provider       String
  eventKey       String
  type           String
  payload        Json
  signatureValid Boolean
  paymentId      String?
  outcome        String?
  receivedAt     DateTime @default(now())

  @@unique([provider, eventKey])
  @@index([paymentId])
}

enum RefundStatus {
  REQUESTED
  PROCESSED
  REJECTED
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Int
  reason        String
  status        RefundStatus @default(REQUESTED)
  reference     String? // référence du transfert de remboursement
  note          String?
  requestedById String
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([orderId])
  @@index([status])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────── Abonnements, fidélité, parrainage ───────────────────────────

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  serviceCode String
  status      SubscriptionStatus @default(PENDING)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  orders Order[]

  @@index([userId])
  @@index([status, periodEnd])
}

model LoyaltyEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ReferralReward {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String   @unique // une seule récompense par filleul
  orderId     String
  promoCodeId String
  createdAt   DateTime @default(now())

  @@index([referrerId])
}

// ─────────────────────────── Statistiques ───────────────────────────

enum MetricSource {
  API
  IMPORT
  MANUAL
}

model MetricSnapshot {
  id            String        @id @default(cuid())
  campaignId    String
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform      Platform
  date          DateTime      @db.Date
  impressions   Int           @default(0)
  reach         Int           @default(0)
  clicks        Int           @default(0)
  engagements   Int           @default(0)
  videoViews    Int           @default(0)
  conversions   Int           @default(0)
  leads         Int           @default(0)
  spend         Int           @default(0) // FCFA
  revenue       Int? // FCFA, déclaré par le client ou mesuré — sert au ROI
  source        MetricSource
  validated     Boolean       @default(false) // seules les lignes validées sont visibles du client
  validatedById String?
  validatedAt   DateTime?
  importId      String?
  import        MetricImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([campaignId, platform, date])
  @@index([campaignId, validated, date])
}

model MetricImport {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploadedById String
  fileName     String
  rowCount     Int
  status       String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  note         String?
  createdAt    DateTime @default(now())

  rows MetricSnapshot[]

  @@index([campaignId])
}

// ─────────────────────────── Communication & support ───────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String?
  notification   Notification?   @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  channel        DeliveryChannel
  recipient      String
  status         DeliveryStatus
  detail         String? // erreur ou motif de non-envoi
  providerRef    String?
  createdAt      DateTime        @default(now())

  @@index([createdAt])
  @@index([status])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id         String       @id @default(cuid())
  reference  String       @unique
  userId     String
  user       User         @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category   String
  subject    String
  body       String
  status     TicketStatus @default(OPEN)
  assigneeId String?
  assignee   User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolution String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

// ─────────────────────────── Création & IA ───────────────────────────

model CreativeTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String
  layout    String // clé d'une mise en page du studio
  palette   Json // { background, accent, text }
  defaults  Json // textes par défaut { headline, subline, cta, badge }
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiGeneration {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String?
  kind       String
  provider   String // nom du fournisseur IA, ou « rules » pour les suggestions guidées
  model      String?
  input      Json
  output     Json
  createdAt  DateTime @default(now())

  @@index([userId, kind, createdAt])
}

model CalendarEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  date       DateTime  @db.Date
  platform   Platform
  title      String
  caption    String?
  hashtags   String[]
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId, date])
}

// ─────────────────────────── Plateforme ───────────────────────────

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
